# =============================================================================
#  Analista Vendite — da usare SOLO se lo esegui su oxy come agente ESTERNO.
#  (Se lo crei in console come "Platform-Hosted" da GitHub, queste variabili le
#   inietta la piattaforma e questo file non serve.)
#  Salva come  agents/sales-analyst/.env  e lancia  ./deploy-to-oxy.sh --env
# =============================================================================

# --- LLM: agente → Configure → LLM Configurations → (provider OpenAI o Ollama) → "Connect to LLM Provider"
LLM_PROVIDER_URL=
LLM_PROVIDER_KEY=
LLM_API_KEY_HEADER=API-Key
LLM_MODEL=gpt-4o-mini
LOCAL_MODEL=qwen2.5:3b

# --- MCP: agente → Configure → Tool Configurations → (alpina-erp) → "Connect to MCP Server"
ERP_MCP_URL=
# proxy con API key:
ERP_MCP_API_KEY=
ERP_MCP_API_KEY_HEADER=X-API-Key
# proxy con OAuth/AgentID (permessi per-tool): lascia vuota ERP_MCP_API_KEY e compila
# Client ID / Secret / Token Endpoint dal pannello "Connect to MCP Server" o da Overview → Agent ID
AMP_AGENTID_CLIENT_ID=
AMP_AGENTID_CLIENT_SECRET=
AMP_AGENTID_TOKEN_ENDPOINT=
AMP_AGENTID_SCOPES=
EXTRA_SCOPES=alpina-erp:read alpina-erp:write

# --- Tracing: agente → Overview → "Setup Agent"
AMP_OTEL_ENDPOINT=
AMP_AGENT_API_KEY=
