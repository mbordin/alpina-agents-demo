# =============================================================================
#  Assistente Clienti (agente ESTERNO su oxy) — valori da copiare dalla console
#  di WSO2 Agent Manager Cloud. Salva come  agents/customer-care/.env  e lancia
#  ./deploy-to-oxy.sh --env   (copia il file su oxy e riavvia il servizio)
#  Formato: CHIAVE=valore, senza virgolette.
# =============================================================================

# --- LLM: agente → Configure → LLM Configurations → (provider Anthropic) → "Connect to LLM Provider"
LLM_KIND=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_URL=
LLM_API_KEY=
LLM_API_KEY_HEADER=API-Key

# --- MCP: agente → Configure → Tool Configurations → (alpina-erp-catalog) → "Connect to MCP Server"
MCP_URL=
MCP_API_KEY=
MCP_API_KEY_HEADER=X-API-Key

# --- Tracing: agente → Overview → "Setup Agent" (Zero-code Instrumentation Guide)
AMP_OTEL_ENDPOINT=
AMP_AGENT_API_KEY=
